{
  "components": {
    "schemas": {
      "ConfigDocument": {
        "additionalProperties": {
          "$ref": "#/components/schemas/JsonValue"
        },
        "description": "Existing config.json object, including preserved extension keys.",
        "title": "ConfigDocument",
        "type": "object"
      },
      "ConfigPatch": {
        "additionalProperties": {
          "$ref": "#/components/schemas/JsonValue"
        },
        "description": "Provided top-level keys replace their values; omitted keys are preserved.",
        "title": "ConfigPatch",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "EventMessage": {
        "properties": {
          "data": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "title": "Data",
            "type": "object"
          },
          "seq": {
            "minimum": 1,
            "title": "Seq",
            "type": "integer"
          },
          "ts": {
            "title": "Ts",
            "type": "number"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "seq",
          "type",
          "ts",
          "data"
        ],
        "title": "EventMessage",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "JsonValue": {},
      "LogBatch": {
        "properties": {
          "entries": {
            "items": {
              "$ref": "#/components/schemas/LogEntry"
            },
            "title": "Entries",
            "type": "array"
          }
        },
        "required": [
          "entries"
        ],
        "title": "LogBatch",
        "type": "object"
      },
      "LogEntry": {
        "properties": {
          "level": {
            "title": "Level",
            "type": "string"
          },
          "logger": {
            "title": "Logger",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "ts": {
            "title": "Ts",
            "type": "number"
          }
        },
        "required": [
          "ts",
          "level",
          "logger",
          "message"
        ],
        "title": "LogEntry",
        "type": "object"
      },
      "LogMessage": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/LogBatch"
          },
          "seq": {
            "minimum": 1,
            "title": "Seq",
            "type": "integer"
          },
          "ts": {
            "title": "Ts",
            "type": "number"
          },
          "type": {
            "const": "log",
            "default": "log",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "seq",
          "ts",
          "data"
        ],
        "title": "LogMessage",
        "type": "object"
      },
      "ShutdownResponse": {
        "properties": {
          "status": {
            "const": "shutting_down",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "ShutdownResponse",
        "type": "object"
      },
      "TaskProgress": {
        "additionalProperties": true,
        "description": "Existing CacheProjectStatistics fields; partial progress updates are valid.",
        "properties": {
          "error_requests": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Error Requests"
          },
          "line": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Line"
          },
          "start_time": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Start Time"
          },
          "time": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Time"
          },
          "token": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Token"
          },
          "total_completion_tokens": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Total Completion Tokens"
          },
          "total_line": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Total Line"
          },
          "total_requests": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Total Requests"
          }
        },
        "title": "TaskProgress",
        "type": "object"
      },
      "TaskUpdateMessage": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/TaskProgress"
          },
          "seq": {
            "minimum": 1,
            "title": "Seq",
            "type": "integer"
          },
          "ts": {
            "title": "Ts",
            "type": "number"
          },
          "type": {
            "const": "task.update",
            "default": "task.update",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "seq",
          "ts",
          "data"
        ],
        "title": "TaskUpdateMessage",
        "type": "object"
      },
      "UpdateResponse": {
        "properties": {
          "current_version": {
            "title": "Current Version",
            "type": "string"
          },
          "latest_version": {
            "title": "Latest Version",
            "type": "string"
          },
          "release_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Release Url"
          },
          "update_available": {
            "title": "Update Available",
            "type": "boolean"
          }
        },
        "required": [
          "current_version",
          "latest_version",
          "update_available",
          "release_url"
        ],
        "title": "UpdateResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VersionResponse": {
        "properties": {
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version"
        ],
        "title": "VersionResponse",
        "type": "object"
      },
      "WebSocketMessage": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/TaskUpdateMessage"
          },
          {
            "$ref": "#/components/schemas/LogMessage"
          },
          {
            "$ref": "#/components/schemas/EventMessage"
          }
        ],
        "description": "Schema-only root used to expose WS messages in generated OpenAPI clients.",
        "title": "WebSocketMessage"
      }
    },
    "securitySchemes": {
      "BearerToken": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "AiNiee API",
    "version": "AiNiee 7.2.6"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/config": {
      "get": {
        "operationId": "get_config",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigDocument"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          }
        },
        "security": [
          {
            "BearerToken": []
          }
        ],
        "summary": "Get Config",
        "tags": [
          "config"
        ]
      },
      "patch": {
        "operationId": "patch_config",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfigPatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigDocument"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "BearerToken": []
          }
        ],
        "summary": "Patch Config",
        "tags": [
          "config"
        ]
      }
    },
    "/api/v1/shutdown": {
      "post": {
        "operationId": "shutdown",
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShutdownResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "security": [
          {
            "BearerToken": []
          }
        ],
        "summary": "Shutdown",
        "tags": [
          "system"
        ]
      }
    },
    "/api/v1/update/check": {
      "get": {
        "operationId": "check_update",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpdateResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Gateway"
          }
        },
        "security": [
          {
            "BearerToken": []
          }
        ],
        "summary": "Check Update",
        "tags": [
          "system"
        ]
      }
    },
    "/api/v1/version": {
      "get": {
        "operationId": "get_version",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          }
        },
        "security": [
          {
            "BearerToken": []
          }
        ],
        "summary": "Version",
        "tags": [
          "system"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "get_health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "system"
        ]
      }
    }
  },
  "x-websocket": {
    "message": {
      "$ref": "#/components/schemas/WebSocketMessage"
    },
    "path": "/api/v1/ws",
    "tokenQueryParameter": "token"
  }
}
